# 공공데이터포털 (금융위원회_주식시세정보) 일반 인증키 (Decoding)
# https://www.data.go.kr 에서 활용신청 후 발급
DATA_GO_KR_API_KEY=

# Supabase (Phase 3에서 사용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Deploy Hook (Phase 3에서 사용)
VERCEL_DEPLOY_HOOK_URL=

# ── 아래는 웹(Next.js)용. 로컬 .env가 아니라 Vercel 프로젝트 환경변수에 넣는다 ──
# 설정 방법은 ANALYTICS_GUIDE.md 참고. 비워두면 해당 기능이 그냥 꺼진다.

# Google Analytics 4 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# 구글 서치 콘솔 소유 확인 메타태그의 content 값 (태그 전체가 아니라 값만)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
