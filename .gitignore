# secrets
.env
.env.local

# 계정 복구 코드·인증 백업. 2026-07-30, Vercel 복구 코드 파일이 이 public 저장소에
# 94커밋에 걸쳐 노출됐다 (코드 재발급 + 이력 제거로 정리). 파일명이 무엇이든
# 프로젝트 폴더에 두지 말 것 — 비밀번호 관리자에 보관한다.
*recovery*code*
*recovery-codes*
*.p8
*.pem
*credentials*.json

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 데이터 캐시 (백필/일별 수집 원본 — 용량 큼, 재생성 가능)
batch/data/cache/

# 배치 산출물 (~63MB) — main에는 커밋하지 않는다.
# GitHub Actions가 매일 data 브랜치에 force-push (daily-batch.yml 참고)
web/public/data/

# node
node_modules/
web/.next/
web/out/
.vercel/

# os
.DS_Store

# 마케팅 워크스페이스 — 별도 private 저장소로 관리한다 (블로그 소스 + 마케팅 전략 문서).
# 이 저장소는 public이므로 여기에 커밋하지 않는다.
kscreener-workspace/

# 스킬·에이전트 작업 폴더 (중간 산출물). 추적 대상이 아닌데 등록이 안 돼 있어
# git add -A 한 번에 올라갈 수 있었다.
_workspace/

# 개인 투자 폴더 — 보유 종목·매매 기록·증권사 키가 오간다. 이 저장소는 public이라
# 커밋되면 그대로 공개된다. 사이트 데이터는 web/public/data/를 로컬에서 읽어 쓴다.
private_investment/
